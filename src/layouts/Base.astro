---
import { Font } from 'astro:assets';
import '../styles/global.css';
import '../styles/components.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { absolute, href } from '../lib/urls';
import { getPlaceholders } from '../lib/placeholders';
import RulesGate from '../components/RulesGate.astro';
import Preloader from '../components/Preloader.astro';
import { getRules, rulesVersion } from '../lib/rules';
import { useLang } from '../i18n';
import tokens from '../styles/global.css?raw';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative URL of the share image (1200×630 works best). */
  image?: string;
  imageAlt?: string;
  page?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Extra breadcrumb links after "← Inicio", e.g. the artists index on a profile. */
  crumbs?: { label: string; href: string }[];
}

const { t, path } = useLang();
const { title, description = t.site.description, image, imageAlt, page = 'page', jsonLd, crumbs = [] } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${t.site.intro}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = image ? new URL(image, Astro.site).href : absolute('/og-default.jpg');
// Every share image is 1200×630 (the default card and the artist crops).
const shareAlt = imageAlt ?? `${site.name}: ${t.site.intro}`;
const placeholders = await getPlaceholders();
const isSample = placeholders.length > 0;
const structured = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// The browser's toolbar color follows the --bg token, so a rebrand only edits global.css.
const themeColor = tokens.match(/--bg:\s*([^;]+);/)?.[1].trim() ?? '#111211';
// The home page places its own inline rules checkpoint; other pages use the dialog.
const rules = await getRules();
// The El espacio page (like the home page's El espacio section) and the visit page
// (address and contact) are readable before accepting.
const gate = rules && !['not-found', 'space', 'visit'].includes(page) ? (page === 'home' ? 'inline' : 'dialog') : undefined;
---

<!doctype html>
<html lang="es" data-rules-version={gate ? rulesVersion(rules!.data.items) : undefined} data-intro={page === 'home' ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {page !== 'not-found' && <link rel="canonical" href={canonical} />}
    {(isSample || page === 'not-found') && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/png" href={href('/favicon.png')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />

    <!-- Preload only the display weights the first screen uses (hero title 800, intro 700). -->
    <Font cssVariable="--font-display" preload={[{ weight: 800 }, { weight: 700 }]} />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        // The intro and the rules are remembered only while moving between pages
        // during a visit. A reload (normal or hard) starts the visit over from the top.
        // The site restores scroll itself: browsers restore it even on reload,
        // which would reopen the page mid-scroll instead of at the intro.
        var nav = window.performance && performance.getEntriesByType ? performance.getEntriesByType('navigation')[0] : null;
        var type = nav ? nav.type : 'navigate';
        var scrollKey = 'shipwreck-scroll:' + location.pathname + location.hash;
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        addEventListener('pagehide', function () {
          try {
            sessionStorage.setItem(scrollKey, String(Math.round(scrollY)));
          } catch (e) {}
        });
        if (type === 'reload') {
          try {
            sessionStorage.removeItem('shipwreck-intro');
            sessionStorage.removeItem('shipwreck-rules');
          } catch (e) {}
          if (location.hash) history.replaceState(null, '', location.pathname + location.search);
        } else if (type === 'back_forward') {
          // Pages restored from the back/forward cache keep their scroll; this covers full reloads.
          var saved = 0;
          try {
            saved = Number(sessionStorage.getItem(scrollKey)) || 0;
          } catch (e) {}
          if (saved) {
            addEventListener('load', function () {
              scrollTo({ top: saved, behavior: 'instant' });
            });
          }
        }
        try {
          localStorage.removeItem('shipwreck-rules'); // Earlier builds kept acceptance permanently.
        } catch (e) {}
        // Home intro (the preloader in Preloader.astro): once per visit, not when
        // returning with Back or arriving at a section link, and never with
        // reduced motion or animations paused.
        if (root.hasAttribute('data-intro') && type !== 'back_forward' && !location.hash) {
          var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
          var seenIntro = true;
          try {
            seenIntro = sessionStorage.getItem('shipwreck-intro') === 'seen';
            still = still || sessionStorage.getItem('shipwreck-motion') === 'paused';
          } catch (e) {}
          if (!seenIntro && !still) root.classList.add('intro');
        }
        // Lock the site before first paint until the rules are accepted in this visit.
        var version = root.getAttribute('data-rules-version');
        if (!version) return;
        var seen;
        try {
          seen = sessionStorage.getItem('shipwreck-rules');
        } catch (e) {
          seen = version;
        }
        if (seen !== version) root.classList.add('rules-pending');
      })();
    </script>
    {structured.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body data-page={page}>
    {page === 'home' && <Preloader />}
    <a class="skip" href="#contenido">{t.nav.skip}</a>
    {
      isSample && (
        <aside class="sample-banner" aria-label={t.sample.bannerLabel}>
          <span>{t.sample.banner}</span>
          <span>{t.sample.bannerText}</span>
        </aside>
      )
    }
    <Header />
    <main id="contenido">
      {
        page !== 'home' && (
          <nav class="crumbs" aria-label={t.nav.crumbs}>
            <a href={href(path('home'))}>
              <i class="icon icon-arrow icon-left" aria-hidden="true" /> {t.nav.homeLink}
            </a>
            {crumbs.map((crumb) => (
              <>
                <span aria-hidden="true">/</span>
                <a href={href(crumb.href)}>{crumb.label}</a>
              </>
            ))}
          </nav>
        )
      }
      <slot />
    </main>
    <Footer showAddress={page !== 'home' && page !== 'visit'} />
    {gate === 'dialog' && <RulesGate mode="dialog" />}
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
