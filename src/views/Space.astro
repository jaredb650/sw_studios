---
import { markdown } from '../lib/markdown';
// El espacio: intro, virtual tour, manifesto (with the SEVENS), venue photos,
// founder, and links to everything else about the venue. Readable before
// accepting the rules; the events pages are the ones behind them.
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SampleChip from '../components/SampleChip.astro';
import YouTube from '../components/YouTube.astro';
import EntryBody from '../components/EntryBody.astro';
import Sevens from '../components/Sevens.astro';
import Lightbox from '../components/Lightbox.astro';
import spacePhoto from '../assets/venue/the-space-bg.jpg';
import { href } from '../lib/urls';
import { useLang } from '../i18n';

const { t: ui, path } = useLang();
const t = ui.spacePage;
const espacio = (await getEntry('pages', 'espacio'))!;
const manifesto = await getEntry('pages', 'manifiesto');
const founder = await getEntry('pages', 'fundador');
const lead = espacio.data.lead;
const outro = manifesto ? manifesto.data.outro : undefined;
const spaceBg = await getImage({ src: spacePhoto, width: 1600, format: 'webp' });
const photos = await Promise.all(
  espacio.data.photos.map(async (photo) => ({ ...photo, large: await getImage({ src: photo.src, width: 2000 }) })),
);
// Desktop mosaic: one large photo beside four small ones, then rows of four.
// Items in an incomplete last row widen so the grid never ends with a gap, and
// with fewer than five photos the ones beside the large photo grow to fill it.
const trailing = Math.max(0, photos.length - 5) % 4;
const few: Record<number, [number, number][]> = { 2: [[2, 2]], 3: [[2, 1], [2, 1]], 4: [[2, 1], [1, 1], [1, 1]] };
const spanFor = (i: number) => {
  if (photos.length === 1) return '--span: 4';
  if (photos.length < 5) return i === 0 ? undefined : `--span: ${few[photos.length][i - 1][0]}; --rows: ${few[photos.length][i - 1][1]}`;
  if (i === 0 || !trailing || i < photos.length - trailing) return undefined;
  const position = i - (photos.length - trailing);
  const spans = { 1: [4], 2: [2, 2], 3: [2, 1, 1] }[trailing] ?? [];
  return `--span: ${spans[position]}`;
};
// Everything venue-related, except events.
const explore = [
  { label: t.exploreLinks.artists, href: path('artists') },
  { label: t.exploreLinks.gallery, href: path('gallery') },
  { label: t.exploreLinks.participate, href: path('participate') },
  { label: t.exploreLinks.rules, href: `${path('home')}#reglas` },
  { label: t.exploreLinks.visit, href: path('visit') },
];
---

<Base title={t.label} description={lead ?? t.description} page="space">
  <PageHero index={t.index} label={t.label} title={t.heading} accent={t.accent} bg={spaceBg.src} split>
    {lead && <p class="mission">{lead}</p>}
  </PageHero>

  {
    espacio.data.videos.length > 0 && (
      <section class="section" aria-labelledby="tour-title">
        <div class="section-heading">
          <h2 id="tour-title">
            <span class="section-index">01 /</span>
            {t.tour}
          </h2>
          <SampleChip show={espacio.data.placeholder} />
        </div>
        <div class={espacio.data.videos.length > 1 ? 'video-grid' : 'tour-player'}>
          {espacio.data.videos.map((video) => (
            <YouTube id={video.youtube} title={video.title} />
          ))}
        </div>
      </section>
    )
  }

  {
    manifesto && (
      <section class="section manifesto" aria-labelledby="manifesto-title">
        <div class="section-heading">
          <h2 id="manifesto-title">
            <span class="section-index">02 /</span>
            {manifesto.data.title}
          </h2>
        </div>
        <div class="manifesto-body">
          <p class="manifesto-lead">{manifesto.data.lead}</p>
          <div class="prose">
            <EntryBody entry={manifesto} />
          </div>
          <Sevens variant="full" label={ui.home.sevens} />
          {outro && <div class="prose manifesto-outro" set:html={markdown(outro)} />}
        </div>
      </section>
    )
  }

  {
    photos.length > 0 && (
      <section class="section" aria-labelledby="photos-title">
        <div class="section-heading">
          <h2 id="photos-title">
            <span class="section-index">03 /</span>
            {t.photos}
          </h2>
          <SampleChip show={espacio.data.placeholder} />
        </div>
        <div class="mosaic">
          {photos.map((photo, i) => (
            <a href={photo.large.src} data-lightbox="espacio" data-title="Shipwreck Studios" data-meta={photo.caption ?? ''} style={spanFor(i)}>
              <Image src={photo.src} alt={photo.alt} width={i === 0 ? 1400 : 700} sizes={i === 0 ? '(max-width: 680px) 100vw, 50vw' : '(max-width: 680px) 50vw, 25vw'} />
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    founder && (
      <section class="section founder" aria-labelledby="founder-title">
        <div class="section-heading">
          <h2 id="founder-title">
            <span class="section-index">04 /</span>
            {founder.data.title}
          </h2>
        </div>
        <div class="split">
          {founder.data.photo && (
            <div class="founder-photo">
              <Image src={founder.data.photo} alt={founder.data.photoAlt ?? founder.data.name ?? ''} width={800} sizes="(max-width: 1000px) 90vw, 35vw" />
            </div>
          )}
          <div>
            {founder.data.role && <p class="label muted">{founder.data.role}</p>}
            {founder.data.name && <h3>{founder.data.name}</h3>}
            <SampleChip show={founder.data.placeholder} />
            <div class="prose" style="margin-top: 22px">
              <EntryBody entry={founder} />
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="explore-title">
    <div class="section-heading">
      <h2 id="explore-title">{t.explore}</h2>
    </div>
    <ul class="explore-links">
      {
        explore.map((item) => (
          <li>
            <a href={href(item.href)}>
              <span>{item.label}</span>
              <span class="round-arrow" aria-hidden="true">
                <i class="icon icon-arrow" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <Lightbox />
</Base>
