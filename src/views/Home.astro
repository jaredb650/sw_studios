---
// Home: one section per header nav item, each ending in a link to its full page.
import { getCollection, getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import spacePhoto from '../assets/venue/the-space-bg.jpg';
import Base from '../layouts/Base.astro';
import FeaturedEvent from '../components/FeaturedEvent.astro';
import EventCard from '../components/EventCard.astro';
import ArtistSpotlight from '../components/ArtistSpotlight.astro';
import VisitBlock from '../components/VisitBlock.astro';
import SectionMore from '../components/SectionMore.astro';
import Lightbox from '../components/Lightbox.astro';
import RulesGate from '../components/RulesGate.astro';
import RulesList from '../components/RulesList.astro';
import SampleChip from '../components/SampleChip.astro';
import Sevens from '../components/Sevens.astro';
import { getAgenda } from '../lib/events';
import { getArtists } from '../lib/artists';
import { site } from '../data/site';
import { href } from '../lib/urls';
import { venueJsonLd } from '../lib/structured-data';
import { getRules } from '../lib/rules';
import { useLang } from '../i18n';

// How many event cards follow the Featured Event on the home page; the rest are on the agenda page.
const HOME_CARDS = 4;

const { t: ui, path } = useLang();
const t = ui.home;
const { upcoming, featured, rest } = await getAgenda();
const preview = rest.slice(0, HOME_CARDS);
const allArtists = await getArtists();
const manifesto = await getEntry('pages', 'manifiesto');
const program = await getEntry('pages', 'programa-de-artistas');
const allCurrent = (await getCollection('artworks', ({ data }) => !data.draft && data.status === 'current')).sort(
  (a, b) => a.data.order - b.data.order,
);
const works = await getCollection('artworks', ({ data }) => !data.draft);
// Home mosaic: up to 5 works, current ones first, then archived.
const MOSAIC_WORKS = 5;
const mosaicWorks = [...allCurrent, ...works.filter((w) => w.data.status === 'archived').sort((a, b) => a.data.order - b.data.order)].slice(0, MOSAIC_WORKS);
const rules = await getRules();
const follow = t.followFirst(site.instagramHandle);
// The seven souls (manifesto) drive the hero typewriter and the preloader.
const souls = (manifesto?.data.items ?? []).map((soul) => soul.title);
const rulesBg = await getImage({ src: spacePhoto, width: 640, quality: 50, format: 'webp' });
---

<Base page="home" jsonLd={venueJsonLd()}>
  <section id="inicio" class="masthead" aria-labelledby="site-title">
    <!-- Looping background video: a wide crop for desktop, a tall one for phones (public/media).
         The still frame shows first; src/scripts/site.ts starts the video after the intro,
         and not at all with reduced motion, paused animations or data saver on. -->
    <div class="hero-media" aria-hidden="true" style={`--poster-wide: url(${href('/media/hero-wide.jpg')}); --poster-tall: url(${href('/media/hero-tall.jpg')})`}>
      <video class="hero-video" muted loop playsinline preload="none" data-hero-video data-poster-wide={href('/media/hero-wide.jpg')} data-poster-tall={href('/media/hero-tall.jpg')}>
        <source src={href('/media/hero-tall.mp4')} type="video/mp4" media="(max-width: 680px)" />
        <source src={href('/media/hero-wide.mp4')} type="video/mp4" />
      </video>
    </div>
    <div class="eyebrow"><span>{ui.site.city}</span><span>{ui.site.tagline}</span></div>
    <div class="hero-composition">
      <h1 id="site-title" class="hero-title">
        <span class="visually-hidden">{souls.length ? ui.site.heroSentence(souls) : 'Shipwreck Studios'}</span>
        <span aria-hidden="true">
          <span class="title-line"><span>SHIPWRECK</span></span>
          <span class="title-line"><span>STUDIOS</span></span>
          <!-- "ES" then each soul is typed out and erased in turn (src/scripts/typewriter.ts). -->
          <span class="title-line typed-line" data-typewriter data-words={JSON.stringify(souls.map((soul) => soul.toUpperCase()))}>
            <span>
              <span class="typed-is">{ui.site.heroIs.toUpperCase()}</span>{' '}
              <span class="typed-word" data-typed>{souls[0]?.toUpperCase()}</span><span class="typed-cursor">_</span>
            </span>
          </span>
        </span>
      </h1>
    </div>
    <div class="mast-bottom">
      <div class="mast-intro">
        <p class="mast-tagline">{ui.site.intro}</p>
        <p class="mast-descriptor">{ui.site.descriptor}</p>
      </div>
      <button class="motion-toggle hero-motion" type="button" hidden data-pause-label={ui.footer.pauseMotion} data-play-label={ui.footer.playMotion}>
        <i class="icon-pause" aria-hidden="true"></i><span data-label>{ui.footer.pauseMotion}</span>
      </button>
      <a class="agenda-jump" href="#espacio" aria-label={t.exploreAgenda}>
        <span>{t.exploreAgenda}</span>
        <span class="round-arrow" aria-hidden="true"><i class="icon icon-arrow icon-down"></i></span>
      </a>
    </div>
  </section>

  <section id="espacio" class="section about" aria-labelledby="about-title">
    <div class="about-label">
      <span class="label">{t.space}</span>
      <figure class="about-photo">
        <Image src={spacePhoto} alt={t.spacePhotoAlt} width={800} sizes="(max-width: 680px) 100vw, 45vw" />
      </figure>
    </div>
    <div>
      <h2 id="about-title" class="manifesto-title">
        {t.manifestoTitle.map((line) => <span class="culture-line">{line}</span>)}
      </h2>
      {manifesto && <p class="lead">{manifesto.data.lead}</p>}
      <p class="manifesto-line">{t.universe}</p>
      <Sevens variant="inline" label={t.sevens} />
      <SectionMore to={path('space')} label={t.knowSpace} detail={t.knowSpaceDetail} plain />
    </div>
  </section>

  <RulesGate mode="inline" />

  <!-- Locked until the visitor accepts the rules (see src/scripts/rules.ts). -->
  <div class="gated" data-gated>
    <section id="agenda" class="section events" aria-labelledby="events-title">
      <div class="section-heading">
        <div>
          <h2 id="events-title"><span class="section-index">{ui.souls.agenda}</span>{t.upcoming}</h2>
          <p class="page-sub">{t.upcomingSub}</p>
        </div>
      </div>

      {featured && <FeaturedEvent event={featured} />}

      <div class="agenda" data-upcoming>
        {
          preview.length > 0 && (
            <div class="agenda-head">
              <h3>{t.nextDates}</h3>
            </div>
          )
        }
        <div class="event-grid">
          {preview.map((event) => <EventCard event={event} group="agenda-inicio" />)}
        </div>
        <p class="row-empty" data-agenda-empty hidden={preview.length > 0}>
          {featured ? t.noMore : t.noEvents} {follow[0]} <a class="inline-link" href={site.socials.instagram} target="_blank" rel="noopener">{follow[1]}</a> {follow[2]}
        </p>
      </div>
      <SectionMore
        to={path('agenda')}
        label={t.seeAgenda}
        detail={t.upcomingCount(upcoming.length)}
        count={{ ends: upcoming.map((event) => event.endsAt.toISOString()), one: t.upcomingCount(1), many: t.upcomingCount(2) }}
      />
    </section>


    <section id="artistas" class="section artists-home" aria-labelledby="artists-title">
      <div class="section-heading">
        <h2 id="artists-title"><span class="section-index">{ui.souls.artists}</span>{t.artists}</h2>
      </div>
      {allArtists.length > 0 ? <ArtistSpotlight /> : <p class="row-empty">{t.noArtists}</p>}
      <SectionMore to={path('artists')} label={t.seeArtists} plain />
    </section>

    <section id="galeria" class="section" aria-labelledby="walls-title">
      <div class="section-heading">
        <h2 id="walls-title"><span class="section-index">{ui.souls.gallery}</span>{t.walls}</h2>
      </div>
      {
        mosaicWorks.length > 0 ? (
          <div class:list={['art-mosaic', `count-${mosaicWorks.length}`]} data-reveal>
            {mosaicWorks.map((work, i) => (
              <a class="art-tile" href={href(`${path('gallery')}#obra-${work.id}`)}>
                <Image src={work.data.image} alt={work.data.alt} width={i === 0 ? 1200 : 640} sizes={i === 0 ? '(max-width: 680px) 90vw, 50vw' : '(max-width: 680px) 45vw, 25vw'} />
                <span class="art-tile-caption">
                  <strong>{work.data.title}</strong>
                  <span>{work.data.status === 'current' ? (work.data.location ?? t.onTheWall) : t.archivedWork}</span>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <p class="row-empty">{t.wallsEmpty}</p>
        )
      }
      <SectionMore to={path('gallery')} label={t.seeGallery} plain />
    </section>

    <section id="participa" class="section" aria-labelledby="participa-title">
      <div class="participa-band" data-reveal>
        <div class="participa-head">
          <span class="label muted">{ui.souls.participate}</span>
          <h2 id="participa-title">{t.participaTitle.join(' ')}</h2>
          <p class="participa-sub">{t.participaSub}</p>
        </div>
        <ul class="participa-offers">
          {
            [
              { title: t.memberTitle, text: t.memberText, more: t.memberMore, to: `${path('participate')}#membresia`, soon: site.patreon.status !== 'live' },
              { title: t.programTitle, text: t.programText, more: t.programMore, to: `${path('participate')}#programa-de-artistas`, soon: program?.data.status !== 'published' },
              { title: t.hostTitle, text: t.hostText, more: t.hostMore, to: `${path('participate')}#propon-un-evento`, soon: false },
            ].map((offer, i) => (
              <li class="participa-offer">
                <span class="participa-kicker">{t.offerKickers[i]}</span>
                <h3>
                  {offer.title} {offer.soon && <span class="chip">{t.soon}</span>}
                </h3>
                <p>{offer.text}</p>
                <a class="text-link" href={href(offer.to)}>
                  {offer.more} <i class="icon icon-arrow icon-right" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      rules && (
        <section id="reglas" class="section bg-photo" style={`--bg-photo: url(${rulesBg.src}); --bg-opacity: .12`} aria-labelledby="rules-title">
          <div class="section-heading">
            <h2 id="rules-title">
              <span class="section-index">{ui.souls.rules}</span>
              {rules.data.title}
            </h2>
            <SampleChip show={rules.data.placeholder} />
          </div>
          <RulesList items={rules.data.items} compact />
        </section>
      )
    }

    <VisitBlock />
  </div>
  <script is:inline>
    // Lock the gated sections right away instead of waiting for the site script.
    if (document.documentElement.classList.contains('rules-pending')) document.querySelector('[data-gated]').inert = true;
  </script>
  <Lightbox />
</Base>
