---
import Base from '../layouts/Base.astro';
import VisitBlock from '../components/VisitBlock.astro';
import { site } from '../data/site';
import { href } from '../lib/urls';
import { venueJsonLd } from '../lib/structured-data';
import { useLang } from '../i18n';

const { t: ui, path } = useLang();
const t = ui.visit;
const { contact, socials } = site;
const channels = [
  contact.email && { label: t.email, value: contact.email, url: `mailto:${contact.email}` },
  contact.phone && { label: t.phone, value: contact.phone, url: `tel:${contact.phone.replace(/[^\d+]/g, '')}` },
  contact.whatsapp && { label: 'WhatsApp', value: contact.whatsapp, url: `https://wa.me/${contact.whatsapp.replace(/\D/g, '')}` },
  { label: 'Instagram', value: t.dm(site.instagramHandle), url: contact.instagramDm },
].filter((channel): channel is { label: string; value: string; url: string } => Boolean(channel));
const socialLinks = Object.entries({ Instagram: socials.instagram, Facebook: socials.facebook, TikTok: socials.tiktok, YouTube: socials.youtube, SoundCloud: socials.soundcloud }).filter(
  (entry): entry is [string, string] => Boolean(entry[1]),
);
---

<Base title={t.title} description={t.description} page="visit" jsonLd={venueJsonLd()}>
  <VisitBlock heading="h1" showMore={false} />

  <section class="section" id="contacto" aria-labelledby="contact-title">
    <div class="split">
      <div class="section-heading" style="display: block">
        <h2 id="contact-title"><span class="section-index">01 /</span>{t.contact}</h2>
      </div>
      <div>
        <ul class="link-list">
          {
            channels.map((channel) => (
              <li>
                <a href={channel.url} target={channel.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
                  <span>
                    <span class="label muted" style="display: block; font-size: 11px">
                      {channel.label}
                    </span>
                    {channel.value}
                  </span>
                  <i class="icon icon-arrow" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
        <p class="fine-print">
          {site.hours ?? t.hoursNote}{' '}
          <a class="inline-link" href={href(path('agenda'))}>{t.seeAgenda}</a>. {t.rulesNote[0]}{' '}
          <a class="inline-link" href={href(`${path('home')}#reglas`)}>{t.rulesNote[1]}</a>.
        </p>
        {
          socialLinks.length > 0 && (
            <div class="profile-block" style="margin-top: 40px">
              <h2>{t.socials}</h2>
              <ul class="link-list">
                {socialLinks.map(([label, url]) => (
                  <li>
                    <a href={url} target="_blank" rel="noopener">
                      {label}
                      <i class="icon icon-arrow" aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Base>
