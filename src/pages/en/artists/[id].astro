---
import ArtistView from '../../../views/Artist.astro';
import { artistPaths, type Artist } from '../../../lib/artists';

export const getStaticPaths = artistPaths;

interface Props {
  artist: Artist;
  prev: Artist;
  next: Artist;
}
const { artist, prev, next } = Astro.props;
---

<ArtistView artist={artist} prev={prev} next={next} />
