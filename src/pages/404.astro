---
// One 404 page for the whole site (GitHub Pages serves it for any missing path).
import Base from '../layouts/Base.astro';
import { href } from '../lib/urls';
import { ui } from '../i18n/ui';
import { routePath } from '../i18n';

---

<Base title={ui.notFound.title} page="not-found">
  <section class="section not-found">
    <p class="label muted">{ui.notFound.code}</p>
    <h1>{ui.notFound.heading[0]}<span>{ui.notFound.heading[1]}</span></h1>
    <p class="prose">{ui.notFound.text}</p>
    <div class="panel-actions">
      <a class="button" href={href(routePath('agenda'))}><span>{ui.notFound.agenda}</span><i class="icon icon-arrow" aria-hidden="true"></i></a>
      <a class="text-link" href={href(routePath('archive'))}>{ui.notFound.archive} <i class="icon icon-arrow" aria-hidden="true"></i></a>
      <a class="text-link" href={href(routePath('visit'))}>{ui.notFound.directions} <i class="icon icon-arrow" aria-hidden="true"></i></a>
    </div>
  </section>
</Base>
