---
// Upcoming event as a flyer card. Opening it (native <details>, so it works
// without JavaScript) spans the full row and shows every detail. Cards in the
// same grid share a `name`, so opening one closes the others.
import { Image, getImage } from 'astro:assets';
import EventDetails from './EventDetails.astro';
import SampleChip from './SampleChip.astro';
import { admissionInfo } from '../lib/admission';
import { clock, dayNumber, isoLocal, longDate, monthShort, weekdayShort } from '../lib/dates';
import { eventAnchor, type Event } from '../lib/events';
import { useLang } from '../i18n';
import { isMusic, listNames } from '../lib/event-kind';

interface Props {
  event: Event;
  group?: string;
}

const { event, group = 'agenda' } = Astro.props;
const { data } = event;
const { t: ui } = useLang();
const t = ui.event;
const anchor = eventAnchor(event);
const admission = admissionInfo(event);
const cancelled = data.status === 'cancelled';
const postponed = data.status === 'postponed';
const multiDay = data.endDate && data.endDate !== data.date;
// Music leads with the lineup; workshops, classes and the rest with who presents them.
const meta = isMusic(event) || !data.organizers.length
  ? (data.lineup.length ? data.lineup.slice(0, 3).join(' · ') : data.organizers.join(' · '))
  : t.presentedBy(listNames(data.organizers));
// The card and the open panel use identical image settings, so the flyer downloads once.
const flyerSizes = '(max-width: 680px) 46vw, 380px';
const flyerLarge = data.flyer ? await getImage({ src: data.flyer, width: 1600 }) : undefined;
const flyerAlt = data.flyerAlt ?? t.flyerOf(data.title);
const ratio = data.flyer ? (data.flyer.width / data.flyer.height).toFixed(4) : '0.8';
---

<details class:list={['event-card', { 'is-cancelled': cancelled }]} id={anchor} name={group} data-type={data.type} data-ends={event.endsAt.toISOString()} data-starts={event.startsAt.toISOString()}>
  <summary>
    <div class="card-flyer">
      {
        data.flyer ? (
          <Image src={data.flyer} alt="" width={760} sizes={flyerSizes} />
        ) : (
          <div class="type-poster" aria-hidden="true">
            <span>{data.title}</span>
          </div>
        )
      }
      <div class="card-flags">
        {cancelled && <span class="chip danger solid-bg">{t.cancelled}</span>}
        {postponed && <span class="chip danger solid-bg">{t.postponed}</span>}
        <span class="chip solid" data-today hidden>{t.today}</span>
        <SampleChip show={data.placeholder} />
      </div>
    </div>
    <div class="card-body">
      <time class="card-date" datetime={isoLocal(data.date, data.start)}>
        {`${weekdayShort(event.startsAt)} ${dayNumber(event.startsAt)} ${monthShort(event.startsAt)}`}
        {data.start && <> · {clock(event.startsAt)}</>}
      </time>
      <h3>{data.title}</h3>
      {meta && <p class="card-meta">{meta}</p>}
      <div class="card-chips">
        <span class="chip type-chip">{t.types[data.type]}</span>
        {multiDay && <span class="chip">{t.until(`${dayNumber(event.endsAt)} ${monthShort(event.endsAt)}`)}</span>}
        {!cancelled && <span class:list={['chip', { accent: data.admission === 'free' }]}>{admission.chip}</span>}
        {data.restrictions && <span class="chip">{data.restrictions}</span>}
      </div>
    </div>
    <span class="card-toggle" aria-hidden="true"><i class="icon icon-plus"></i></span>
    <span class="visually-hidden">{t.viewDetails(data.title)}</span>
  </summary>

  <div class:list={['event-panel', { 'no-flyer': !data.flyer }]} style={`--ratio: ${ratio}`}>
    {
      data.flyer && flyerLarge && (
        <a class="flyer ev-flyer" href={flyerLarge.src} data-lightbox={anchor} data-title={data.title} data-meta={longDate(event.startsAt)}>
          <Image src={data.flyer} alt={flyerAlt} width={760} sizes={flyerSizes} />
        </a>
      )
    }
    <EventDetails event={event} mode="upcoming" />
  </div>
</details>
