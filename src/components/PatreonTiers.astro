---
import SampleChip from './SampleChip.astro';
import ComingSoon from './ComingSoon.astro';
import { site } from '../data/site';
import { useLang } from '../i18n';

const { patreon } = site;
const tiers = patreon.tiers.slice(0, 3);
const { t: ui } = useLang();
const t = ui.participaPage;
---

{
  patreon.status === 'live' && tiers.length > 0 ? (
    <>
      <!-- A plain list: each tier's name, monthly price, benefits and join link. -->
      <ul class="tier-list">
        {tiers.map((tier) => (
          <li class="tier-row">
            <div>
              <p class="tier-name">{tier.name}</p>
              <p class="tier-price">
                ${tier.price} <span>{t.perMonth}</span>
              </p>
            </div>
            <div class="tier-detail">
              {tier.summary && <p>{tier.summary}</p>}
              <ul>
                {tier.benefits.map((benefit) => (
                  <li>{benefit}</li>
                ))}
              </ul>
            </div>
            <a class="text-link" href={tier.url ?? patreon.url} target="_blank" rel="noopener">
              {t.join}<span class="visually-hidden">: {tier.name}</span> <i class="icon icon-arrow" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
      <p class="fine-print">
        {t.finePrint} <SampleChip show={patreon.placeholder} />
      </p>
    </>
  ) : (
    <ComingSoon lead={t.tiersSoon} />
  )
}
