---
import { pages, site } from '../data/site';
import { href } from '../lib/urls';
import { useLang } from '../i18n';

const { t, path } = useLang();
const socials = [
  ['Instagram', site.socials.instagram],
  ['Facebook', site.socials.facebook],
  ['TikTok', site.socials.tiktok],
  ['YouTube', site.socials.youtube],
  ['SoundCloud', site.socials.soundcloud],
  ['Patreon', site.patreon.status === 'live' ? site.patreon.url : null],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
const { address } = site;

interface Props {
  /** Pages that already show the address and directions (home, Visítanos) skip them here. */
  showAddress?: boolean;
}
const { showAddress = true } = Astro.props;
---

<!-- Two compact rows: the logo, pages and networks; then the address, copyright and motion toggle. -->
<footer class="site-footer">
  <div class="footer-inner">
    <a class="logo" href={href(path('home'))} aria-label={t.nav.home}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>SHIPWRECK STUDIOS<span class="accent">_</span></span>
    </a>
    <nav class="footer-links" aria-label={t.footer.explore}>
      <ul>
        {pages.map((route) => <li><a href={href(path(route))}>{t.footer.pages[route]}</a></li>)}
      </ul>
    </nav>
    <ul class="footer-social" aria-label={t.footer.follow}>
      {
        socials.map(([label, url]) => (
          <li>
            <a href={url} target="_blank" rel="noopener">
              {label} <i class="icon icon-arrow" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="footer-bottom">
    {
      showAddress && (
        <address>
          {address.street}, {address.neighborhood}, {address.city}{address.postalCode && ` ${address.postalCode}`} ·{' '}
          <a class="inline-link" href={address.mapsUrl} target="_blank" rel="noopener">{t.footer.directions}</a>
        </address>
      )
    }
    <span>© {new Date().getFullYear()} Shipwreck Studios · {t.site.city}</span>
    <button class="motion-toggle" type="button" hidden data-pause-label={t.footer.pauseMotion} data-play-label={t.footer.playMotion}>{t.footer.pauseMotion}</button>
  </div>
</footer>
