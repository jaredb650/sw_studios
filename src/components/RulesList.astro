---

interface Props {
  items: { title: string; text: string }[];
  compact?: boolean;
}
const { items, compact = false } = Astro.props;
---

<ol class:list={['rules', { compact }]}>
  {
    items.map((rule) => (
      <li>
        <div>
          <h3>{rule.title}</h3>
          <p>{rule.text}</p>
        </div>
      </li>
    ))
  }
</ol>
