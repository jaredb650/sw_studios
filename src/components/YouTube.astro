---
// Click-to-load YouTube player: the thumbnail is downloaded at build time and
// served from this site, so YouTube receives no requests until the visitor
// presses play. A `file` (an MP4 in public/) plays from this site instead,
// loading only when pressed. With neither it shows a "video coming soon" frame.
import { Image } from 'astro:assets';
import { useLang } from '../i18n';
import { href } from '../lib/urls';

interface Props {
  id?: string;
  file?: string;
  poster?: string;
  title: string;
  caption?: string;
}
const { id, file, poster, title, caption } = Astro.props;
const { t } = useLang();
---

<figure style="margin: 0">
  {
    file ? (
      <div class="video">
        <video controls playsinline preload="none" poster={poster && href(poster)} aria-label={title}>
          <source src={href(file)} type="video/mp4" />
        </video>
      </div>
    ) : id ? (
      <div class="video" data-youtube={id}>
        <a class="video-trigger" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener">
          <Image src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width={480} height={360} />
          <span class="video-play" aria-hidden="true">
            <i class="icon icon-play" />
          </span>
          <span class="visually-hidden">{t.video.play(title)}</span>
        </a>
      </div>
    ) : (
      <div class="video pending" role="img" aria-label={t.video.soonLabel(title)}>
        <div>
          <span class="video-play" aria-hidden="true" style="margin: 0 auto">
            <i class="icon icon-play" />
          </span>
          <p>{t.video.soon}</p>
        </div>
      </div>
    )
  }
  <figcaption class="video-caption"><span>{title}</span>{caption && <span>{caption}</span>}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-youtube]').forEach((video) => {
    video.querySelector('a')?.addEventListener('click', (event) => {
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${video.dataset.youtube}?autoplay=1&rel=0`;
      iframe.title = video.querySelector('.visually-hidden')?.textContent ?? 'YouTube';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      video.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
