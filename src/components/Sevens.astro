---
// The seven souls (SEVENS) from the manifesto: src/content/pages/manifiesto.md → items.
import { getEntry } from 'astro:content';
import { pick, useLang } from '../i18n';

interface Props {
  /** "inline" (names in a row) for the home page, "full" for the El espacio page. */
  variant?: 'inline' | 'compact' | 'full';
  label?: string;
}
const { variant = 'full', label } = Astro.props;
const { lang } = useLang(Astro.url);
const manifesto = await getEntry('pages', 'manifiesto');
const souls = manifesto?.data.items ?? [];
---

{
  souls.length > 0 && variant === 'inline' && (
    // One line when it fits; otherwise 4 on top and 3 below (src/scripts/site.ts
    // hides the star between the groups once they wrap).
    <div class="sevens inline" role="list" aria-label={label} data-sevens>
      {[souls.slice(0, 4), souls.slice(4)].map((group, g) => (
        <>
          {g > 0 && <span class="sevens-sep" aria-hidden="true" />}
          <span class="sevens-group" role="presentation">
            {group.map((soul) => (
              <span class="seven" role="listitem" title={pick(soul, 'text', lang)}>
                {pick(soul, 'title', lang)}
              </span>
            ))}
          </span>
        </>
      ))}
    </div>
  )
}
{
  souls.length > 0 && variant !== 'inline' && (
    <ol class:list={['sevens', variant]} aria-label={label}>
      {souls.map((soul, i) => (
        <li>
          <span class="seven-index" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="seven-name">{pick(soul, 'title', lang)}</span>
          <span class="seven-verb">{pick(soul, 'text', lang)}</span>
        </li>
      ))}
    </ol>
  )
}
