---
interface Props {
  /** Optional faded background photo (URL). */
  bg?: string;
  /** A short line after the label, e.g. the souls the page serves. */
  kicker?: string;
  label: string;
  title: string;
  accent?: string;
  lead?: string;
  /** Title on the left, lead and slot content on the right. */
  split?: boolean;
}
const { kicker, label, title, accent, lead, bg, split = false } = Astro.props;
---

<header class:list={['page-hero', { 'bg-photo': bg, 'is-split': split }]} style={bg ? `--bg-photo: url(${bg})` : undefined}>
  <div class="eyebrow">
    <span>{label}{kicker && <span class="muted"> · {kicker}</span>}</span>
  </div>
  {
    split ? (
      <div class="page-hero-grid">
        <h1>
          {title}
          {accent && (
            <>
              <br />
              <span class="accent">{accent}</span>
            </>
          )}
        </h1>
        <div class="page-hero-side">
          {lead && <p class="lead">{lead}</p>}
          <slot />
        </div>
      </div>
    ) : (
      <>
        <h1>
          {title}
          {accent && (
            <>
              <br />
              <span class="accent">{accent}</span>
            </>
          )}
        </h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </>
    )
  }
</header>
