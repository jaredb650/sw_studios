---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SampleChip from './SampleChip.astro';
import type { Artist } from '../lib/artists';
import { href } from '../lib/urls';
import { pick, useLang } from '../i18n';

interface Props {
  work: CollectionEntry<'artworks'>;
  artists: Artist[];
  group?: string;
}

const { work, artists, group = 'galeria' } = Astro.props;
const { data } = work;
const { lang, t: ui, artist: artistPath } = useLang(Astro.url);
const t = ui.galleryPage;
const artist = data.artist ? artists.find((a) => a.id === data.artist!.id) : undefined;
const credit = artist?.data.name ?? data.artistName ?? '';
const large = await getImage({ src: data.image, width: 2000 });
const ratio = (data.image.width / data.image.height).toFixed(4);
const meta = [data.year, pick(data, 'medium', lang), pick(data, 'dimensions', lang)].filter(Boolean).join(' · ');
const location = pick(data, 'location', lang);
const archivedNote = pick(data, 'archivedNote', lang);
const caption = [credit, meta, data.status === 'current' ? location : archivedNote].filter(Boolean).join(' — ');
---

<figure class="art-item" style={`--ratio: ${ratio}`} id={`obra-${work.id}`} data-reveal>
  <a href={large.src} data-lightbox={group} data-title={data.title} data-meta={caption} data-enlarge={t.enlarge}>
    <Image src={data.image} alt={pick(data, 'alt', lang)} width={1200} sizes="(max-width: 680px) 90vw, 40vw" />
  </a>
  <figcaption>
    <h3>{data.title}</h3>
    <p class="art-credit">
      {artist ? <a href={href(artistPath(artist.id))}>{credit}</a> : credit}
    </p>
    {meta && <p class="art-meta">{meta}</p>}
    <div class="art-chips">
      {data.status === 'current' ? <span class="chip accent">{t.onWall}</span> : <span class="chip">{t.archivedChip}</span>}
      {data.status === 'current' && location && <span class="chip">{location}</span>}
      {data.status === 'archived' && archivedNote && <span class="chip">{archivedNote}</span>}
      <SampleChip show={data.placeholder} />
    </div>
  </figcaption>
</figure>
